# Copy to .env.local and fill in your own values. Never commit real keys.

# ── Supabase (required for auth + cloud sync) ──────────────────────────────
# Dashboard → Project Settings → API. Use the Project URL and the anon /
# publishable key. NEVER put the service_role key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ── OpenAI (server-only; optional — AI features degrade gracefully) ────────
# Powers /api/coach-feedback, /api/explain-form, /api/food-scan, and
# /api/mind/reflect (model: gpt-4o-mini). Do NOT prefix with NEXT_PUBLIC_ —
# that would ship the key inside the client JavaScript bundle.
OPENAI_API_KEY=your-openai-api-key

# ── USDA FoodData Central (server-only; optional — food search) ────────────
# Free key: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=your-usda-fdc-api-key
